{
	/**
    * Wrangler configuration file for Cloudflare Workers
    * For more information, see: https://developers.cloudflare.com/workers/wrangler/configuration/
    IMPORTANT:
     - Preview and production share one Cloudflare account and this one Worker,
       so there is no "env" block: previews are Worker *versions* carrying a
       preview alias (<branch>-mosaic-website.<subdomain>.workers.dev), and
       production is whichever version is currently deployed.
     - Promoting a version to production is `wrangler versions deploy`.
    */
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mosaic-website",
	"main": ".open-next/worker.js",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public",
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		"run_worker_first": false,
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mosaic-website",
		},
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
		},
	},
	"logpush": true,
	"vars": {
		"ENVIRONMENT": "production",
	},
	// Using workers.dev domain for staging (production preview) environment
	"preview_urls": true,
	"workers_dev": true,
}
