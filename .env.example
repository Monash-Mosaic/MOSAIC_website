# Server-only. Do not prefix these with NEXT_PUBLIC_.
# Local: copy to .env.local. Production: set the same names in GitHub Actions
# and in the host runtime (Vercel/server env), not just the build job.

# local = use src/modules/projects/localProjects.json (no Apps Script)
# production = fetch from APPS_SCRIPT_URL with Google OAuth
APP_ENV=local

APPS_SCRIPT_URL=https://script.google.com/a/macros/student.monash.edu/s/AKfycbxKVjKeLH9syQl1eWE5y2Mhbs20NMLZXATEJjknHnl_AgDMwj0yAyLF-yN7d0TwEKrt/exec?action=projects

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Used by POST /api/projects/refresh and the GitHub Actions workflow.
CACHE_REFRESH_SECRET=
SITE_URL=http://localhost:3000

# Optional. Defaults to Drive readonly + email, which Apps Script web apps require.
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email
