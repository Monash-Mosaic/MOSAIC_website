{
  "name": "mosaic-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "google:token": "node scripts/get-google-refresh-token.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write $(git diff --name-only --diff-filter=ACM HEAD | grep -E '\\.(js|jsx|ts|tsx|json|css|md)$')",
    "ci:build": "opennextjs-cloudflare build",
    "ci:test": "vitest run --coverage --reporter=default --reporter=github-actions --reporter=junit --reporter=json --outputFile.junit=junit.xml --outputFile.json=report.json",
    "ci:e2e": "playwright test"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "vitest": "^4.1.11",
    "wrangler": "^4.24.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "uuid": "^11.1.1"
  }
}
